<div class="py-5 container">
    <!-- Hero Section with Glowing Ambient Backdrop -->
    <div class="mb-5 text-center position-relative">
        <div class="position-absolute top-50 start-50 translate-middle bg-info opacity-10 rounded-circle" style="width: 280px; height: 280px; filter: blur(70px); z-index: -1;"></div>
        
        <span class="badge bg-info bg-opacity-10 text-white border border-info border-opacity-25 px-3 py-2 rounded-pill font-monospace mb-3 shadow-sm">
            ⚡ DECEMBER HACKATHON &bull; PROJECTCODEX
        </span>
        <h1 class="display-3 fw-bold text-white mb-3 tracking-tight">
            Move<span class="text-info">Makers</span>
        </h1>
        <p class="lead text-white-50 mx-auto" style="max-width: 480px; font-weight: 300; line-height: 1.6;">
            Step in front of your camera, master 4 real-time PoseNet gesture challenges, and conquer the leaderboard!
        </p>
    </div>

    <!-- Player Entry Form Card -->
    <div class="card bg-dark bg-opacity-75 border border-info border-opacity-20 shadow-lg mx-auto p-4 p-md-5 rounded-4 text-start position-relative overflow-hidden" style="max-width: 460px; backdrop-filter: blur(12px);">
        <!-- Top Neon Accent Line -->
        <div class="position-absolute top-0 start-0 end-0 bg-info opacity-75" style="height: 3px;"></div>
        
        <div class="d-flex align-items-center mb-4">
            <div class="bg-info bg-opacity-15 p-2 rounded-3 text-info me-3 fs-4">🎮</div>
            <div>
                <h5 class="fw-bold text-white mb-0">Player Registration</h5>
                <small class="text-white-50">Enter your alias to start your session</small>
            </div>
        </div>

        <form action="/add/player" method="post">
            <div class="mb-3">
                <label for="validationDefault01" class="form-label text-white-50 small fw-bold font-monospace">Player Name / Alias:</label>
                <div class="input-group">
                    <span class="input-group-text bg-black border-secondary border-opacity-50 text-info">👤</span>
                    <input type="text" class="form-control bg-black border-secondary border-opacity-50 text-black py-2 ps-3 shadow-none" id="validationDefault01" name="name" placeholder="Enter your gamer tag..." required autofocus>
                </div>
            </div>
            <div class="mb-4">
                <label for="validationDefault02" class="form-label text-white-50 small fw-bold font-monospace">Age:</label>
                <div class="input-group">
                    <span class="input-group-text bg-black border-secondary border-opacity-50 text-info">🎂</span>
                    <input type="number" class="form-control bg-black border-secondary border-opacity-50 text-black py-2 ps-3 shadow-none" id="validationDefault02" name="age" placeholder="e.g. 21" min="1" max="120" required>
                </div>
            </div>
            <div class="d-grid gap-2 pt-2">
                <button class="btn btn-success btn-lg fw-bold shadow-lg py-3 d-flex align-items-center justify-content-center gap-2" type="submit" style="background: linear-gradient(135deg, #198754 0%, #157347 100%); border: none;">
                    <span>Start Session</span>
                    <span class="fs-5">🚀</span>
                </button>
                <a href="/scoreboard" class="btn btn-outline-secondary border-opacity-25 btn-sm text-white-50 mt-2 py-2 d-flex align-items-center justify-content-center gap-2">
                    <span>🏆</span> View Leaderboard
                </a>
            </div>
        </form>
    </div>
</div>