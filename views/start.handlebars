{{> header}}

<div class="container py-3">
    <!-- Active Challenge Header Card -->
    <div class="card bg-dark border-info border-opacity-25 shadow-lg mb-3 mx-auto" style="max-width: 680px;">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span id="challenge-badge" class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-50 font-monospace">
                    CHALLENGE <span id="challenge-num">1</span> OF 4
                </span>
                <div class="d-flex gap-2">
                    <a href="/start" target="_blank" rel="noopener" class="badge bg-primary text-white text-decoration-none border border-primary font-monospace py-1" title="Open in dedicated tab for direct camera access">
                        ⎘ Open in Tab
                    </a>
                    <span id="person-indicator" class="badge bg-secondary font-monospace">
                        👤 Person: Off
                    </span>
                    <span id="audio-status-btn" class="badge bg-secondary bg-opacity-25 text-light border border-secondary cursor-pointer" role="button">
                        🔊 Sound ON
                    </span>
                </div>
            </div>

            <!-- Main Question Display -->
            <h2 id="question" class="display-6 fw-bold text-white mb-1">
                Make the gesture for Hungry
            </h2>
            <p id="gesture-hint" class="small text-info text-opacity-75 mb-2 font-monospace">
                Hint: Bring your hand up towards your mouth as if eating.
            </p>

            <!-- Progress Bar -->
            <div class="progress bg-dark border border-secondary border-opacity-50" style="height: 6px;">
                <div id="challenge-progress" class="progress-bar bg-info progress-bar-striped progress-bar-animated" role="progressbar" style="width: 25%;"></div>
            </div>

            <!-- Pose Hold Confirmation Bar -->
            <div id="hold-progress-container" class="mt-2" style="display: none;">
                <div class="d-flex justify-content-between small font-monospace text-success mb-1">
                    <span id="hold-status-text">Holding Hungry pose...</span>
                    <span id="hold-pct">0%</span>
                </div>
                <div class="progress bg-dark border border-success border-opacity-50" style="height: 8px;">
                    <div id="hold-bar" class="progress-bar bg-success progress-bar-striped progress-bar-animated" style="width: 0%;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Center Camera HUD Viewfinder -->
    <div class="text-center position-relative my-2">
        <div id="position-yourself" class="small text-info text-opacity-75 mb-2 font-monospace">
            1. Stand or sit so your upper body (shoulders & arms) are visible in the frame
        </div>

        <div class="hud-viewfinder mx-auto position-relative" style="width: 380px; height: 380px; max-width: 92vw;">
            <!-- Viewfinder HUD Overlays -->
            <div class="hud-corner hud-corner-tl"></div>
            <div class="hud-corner hud-corner-tr"></div>
            <div class="hud-corner hud-corner-bl"></div>
            <div class="hud-corner hud-corner-br"></div>
            <div class="hud-reticle"></div>
            <div id="hud-scanner" class="hud-scanner" style="display: none;"></div>

            <!-- Live HUD Status Badge -->
            <div class="hud-status-badge">
                <div id="hud-status-dot" class="hud-pulse-dot" style="background-color: #64748b;"></div>
                <span id="hud-status-text">CAMERA STANDBY</span>
            </div>

            <!-- Top Right Camera Controls -->
            <div class="position-absolute top-0 end-0 m-2 d-flex gap-1" style="z-index: 8;">
                <button id="mirror-btn" type="button" class="btn btn-sm btn-dark border border-secondary border-opacity-50 text-white-50" title="Flip Camera Orientation">
                    ⇄ Flip
                </button>
            </div>

            <!-- Off-screen active HTML5 video stream element (NOT d-none so browser continues decoding frames!) -->
            <video id="webcam-video" playsinline muted autoplay style="position: absolute; opacity: 0; pointer-events: none; width: 1px; height: 1px; z-index: -1;"></video>

            <!-- Primary Drawing Canvas Element -->
            <canvas id="canvas" width="380" height="380" class="w-100 h-100" style="display: none; object-fit: cover;">
                <div id="webcam-container"></div>
            </canvas>

            <!-- Idle / Standby Screen -->
            <div id="camera-idle-screen" class="d-flex flex-column align-items-center justify-content-center w-100 h-100 p-4">
                <div class="mb-3 text-info text-opacity-50" style="font-size: 52px;">📷</div>
                <h5 class="text-white mb-1">Ready for Action</h5>
                <p class="small text-white-50 mb-3">Click the green <strong>Start Camera</strong> button below to enable real-time pose tracking.</p>
                <div class="small text-info text-opacity-75 font-monospace">
                    Tip: Ensure good lighting so your shoulders & arms are clear
                </div>
            </div>

            <!-- Bottom Tracking HUD Bar -->
            <div id="camera-hud-bottom" class="position-absolute bottom-0 start-0 end-0 px-3 py-1.5 bg-dark bg-opacity-75 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center small font-monospace" style="z-index: 7; display: none !important;">
                <span id="body-tracking-label" class="text-white-50">
                    Keypoints: <strong class="text-info">0/17</strong>
                </span>
                <span id="body-confidence-label" class="text-success">
                    Confidence: <strong class="text-white">0%</strong>
                </span>
            </div>

            <!-- Success Feedback Overlay -->
            <div id="correct-toggle" class="hud-feedback-overlay card bg-success text-white shadow-lg p-3 text-center border-0" style="display: none;">
                <div style="font-size: 36px;">✨</div>
                <h3 id="correct-toggle-header" class="fw-bold mb-1">Correct!</h3>
                <p class="small text-white-50 mb-0">Gesture recognized & confirmed!</p>
            </div>

            <!-- Incorrect Feedback Overlay -->
            <div id="incorrect-toggle" class="hud-feedback-overlay card bg-danger text-white shadow-lg p-3 text-center border-0" style="display: none;">
                <div style="font-size: 36px;">⚠️</div>
                <h4 id="incorrect-toggle-header" class="fw-bold mb-1">Try Again</h4>
                <p class="small text-white-50 mb-0">Step back and hold pose steady</p>
            </div>

            <!-- Camera Access Error Overlay -->
            <div id="camera-error-overlay" class="hud-feedback-overlay card bg-dark border-danger text-white shadow-lg p-3 text-center" style="display: none; border-width: 2px; width: 90%; max-width: 340px; z-index: 20;">
                <div class="text-danger mb-1" style="font-size: 32px;">🚫 📷</div>
                <h5 class="fw-bold text-danger mb-1">Camera Access Error</h5>
                <p id="camera-error-message" class="small text-white-50 mb-3 font-monospace" style="font-size: 11px;">
                    Unable to initialize video stream. Please verify your camera permissions.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <button id="retry-camera-btn" type="button" class="btn btn-sm btn-outline-danger px-3">
                        ↻ Retry Camera
                    </button>
                    <button id="dismiss-error-btn" type="button" class="btn btn-sm btn-outline-secondary px-3">
                        Use Test Buttons
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Live ML Prediction Probability Meters -->
    <div class="my-3 mx-auto" style="max-width: 680px;">
        <div class="row g-2" id="prediction-meters-container">
            <div class="col-6 col-md-3">
                <div class="hud-pred-card text-start active-target" id="pred-card-0">
                    <div class="d-flex justify-content-between small text-white-50 mb-1">
                        <span class="fw-bold text-white">🍽️ Hungry</span>
                        <span id="pred-pct-0" class="font-monospace text-info">0%</span>
                    </div>
                    <div class="hud-meter">
                        <div id="pred-bar-0" class="hud-meter-fill" style="width: 0%;"></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="hud-pred-card text-start" id="pred-card-1">
                    <div class="d-flex justify-content-between small text-white-50 mb-1">
                        <span class="fw-bold text-white">👀 I See You</span>
                        <span id="pred-pct-1" class="font-monospace text-info">0%</span>
                    </div>
                    <div class="hud-meter">
                        <div id="pred-bar-1" class="hud-meter-fill" style="width: 0%;"></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="hud-pred-card text-start" id="pred-card-2">
                    <div class="d-flex justify-content-between small text-white-50 mb-1">
                        <span class="fw-bold text-white">🤫 Quiet Down</span>
                        <span id="pred-pct-2" class="font-monospace text-info">0%</span>
                    </div>
                    <div class="hud-meter">
                        <div id="pred-bar-2" class="hud-meter-fill" style="width: 0%;"></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="hud-pred-card text-start" id="pred-card-3">
                    <div class="d-flex justify-content-between small text-white-50 mb-1">
                        <span class="fw-bold text-white">💃 Get Busy</span>
                        <span id="pred-pct-3" class="font-monospace text-info">0%</span>
                    </div>
                    <div class="hud-meter">
                        <div id="pred-bar-3" class="hud-meter-fill" style="width: 0%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Game Action Controls -->
    <div class="controls my-3 text-center">
        <button id="start-button" type="button" class="btn btn-success btn-lg px-4 me-2 shadow">
            ▶ Start Camera
        </button>
        <button id="stop" type="button" class="btn btn-danger btn-lg px-4 me-2 shadow" style="display: none;">
            ⏹ Stop Camera
        </button>
        <button id="restart" type="button" class="btn btn-primary btn-lg px-4 shadow" style="display: none;">
            🔄 Play Again
        </button>
    </div>

    <!-- Teachable Machine Links Card -->
    <div class="card bg-dark border-secondary border-opacity-25 mx-auto mt-3 p-3 text-start small font-monospace" style="max-width: 680px;">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-white fw-bold">🧠 Google Teachable Machine Models:</span>
            <span class="badge bg-success bg-opacity-25 text-success border border-success">PoseNet v0.8</span>
        </div>
        <div class="text-white-50 small mb-2">
            Trained with 4 classes: <strong>Hungry, ISeeYou, QuietDown, GetBusy</strong>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="https://teachablemachine.withgoogle.com/models/C8EwO48qN/" target="_blank" rel="noopener" class="btn btn-sm btn-outline-info text-decoration-none">
                🔗 Active Model: C8EwO48qN (Dec 11 Hackathon) ↗
            </a>
            <a href="https://teachablemachine.withgoogle.com/models/Ybj48BAov/" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary text-decoration-none">
                🔗 Archive Model: Ybj48BAov (Dec 9 v1) ↗
            </a>
        </div>
    </div>
</div>

<div class="container text-center">
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@1.3.1/dist/tf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@teachablemachine/pose@0.8/dist/teachablemachine-pose.min.js"></script>
    <script src="/js/model.js"></script>
</div>

{{> footer}}