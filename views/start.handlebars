{{> header.handlebars}}

<div class="container py-3">
    <!-- Active Challenge Header Card -->
    <div class="card bg-dark border-info border-opacity-25 shadow-lg mb-3 mx-auto" style="max-width: 680px;">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span id="challenge-badge" class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-50 font-monospace">
                    CHALLENGE <span id="challenge-num">1</span> OF 4
                </span>
                <span id="audio-status-btn" class="badge bg-secondary bg-opacity-25 text-light border border-secondary cursor-pointer" role="button">
                    🔊 Sound ON
                </span>
            </div>

            <!-- Main Question Display -->
            <h2 id="question" class="display-6 fw-bold text-white mb-1">
                Make the gesture for Hungry
            </h2>
            <p id="gesture-hint" class="small text-info text-opacity-75 mb-2 font-monospace">
                Hint: Bring your hand up towards your mouth as if eating.
            </p>

            <!-- Progress Bar -->
            <div class="progress bg-dark border border-secondary border-opacity-50" style="height: 6px;">
                <div id="challenge-progress" class="progress-bar bg-info progress-bar-striped progress-bar-animated" role="progressbar" style="width: 25%;"></div>
            </div>
        </div>
    </div>

    <!-- Center Camera HUD Viewfinder -->
    <div class="text-center position-relative my-2">
        <div id="position-yourself" class="small text-info text-opacity-75 mb-2 font-monospace">
            1. Align yourself with device camera and click Start
        </div>

        <div class="hud-viewfinder mx-auto position-relative" style="width: 360px; height: 360px; max-width: 90vw;">
            <!-- Viewfinder HUD Overlays -->
            <div class="hud-corner hud-corner-tl"></div>
            <div class="hud-corner hud-corner-tr"></div>
            <div class="hud-corner hud-corner-bl"></div>
            <div class="hud-corner hud-corner-br"></div>
            <div class="hud-reticle"></div>
            <div id="hud-scanner" class="hud-scanner" style="display: none;"></div>

            <!-- Live HUD Status Badge -->
            <div class="hud-status-badge">
                <div id="hud-status-dot" class="hud-pulse-dot" style="background-color: #64748b;"></div>
                <span id="hud-status-text">CAMERA STANDBY</span>
            </div>

            <!-- Top Right Mirror Toggle -->
            <button id="mirror-btn" type="button" class="btn btn-sm btn-dark position-absolute top-0 end-0 m-2 border border-secondary border-opacity-50 text-white-50" style="z-index: 8;" title="Flip Camera Orientation">
                ⇄ Flip
            </button>

            <!-- Canvas Element -->
            <canvas id="canvas" width="360" height="360" class="w-100 h-100" style="display: none; object-fit: cover;">
                <div id="webcam-container"></div>
            </canvas>

            <!-- Idle / Standby Screen -->
            <div id="camera-idle-screen" class="d-flex flex-column align-items-center justify-content-center w-100 h-100 p-4">
                <div class="mb-3 text-info text-opacity-50" style="font-size: 48px;">📷</div>
                <h5 class="text-white mb-1">Ready for Action</h5>
                <p class="small text-white-50 mb-0">Click the green <strong>Start</strong> button below to launch webcam tracking.</p>
            </div>

            <!-- Success Feedback Overlay -->
            <div id="correct-toggle" class="hud-feedback-overlay card bg-success text-white shadow-lg p-3 text-center border-0" style="display: none;">
                <div style="font-size: 36px;">✨</div>
                <h3 id="correct-toggle-header" class="fw-bold mb-1">Correct!</h3>
                <p class="small text-white-50 mb-0">Gesture recognized with high confidence</p>
            </div>

            <!-- Incorrect Feedback Overlay -->
            <div id="incorrect-toggle" class="hud-feedback-overlay card bg-danger text-white shadow-lg p-3 text-center border-0" style="display: none;">
                <div style="font-size: 36px;">⚠️</div>
                <h4 id="incorrect-toggle-header" class="fw-bold mb-1">Try Again</h4>
                <p class="small text-white-50 mb-0">Hold pose steady in front of camera</p>
            </div>
        </div>
    </div>

    <!-- Live ML Prediction Probability Meters -->
    <div class="my-3 mx-auto" style="max-width: 680px;">
        <div class="row g-2" id="prediction-meters-container">
            <div class="col-6 col-md-3">
                <div class="hud-pred-card text-start active-target" id="pred-card-0">
                    <div class="d-flex justify-content-between small text-white-50 mb-1">
                        <span class="fw-bold text-white">🍽️ Hungry</span>
                        <span id="pred-pct-0" class="font-monospace text-info">0%</span>
                    </div>
                    <div class="hud-meter">
                        <div id="pred-bar-0" class="hud-meter-fill" style="width: 0%;"></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="hud-pred-card text-start" id="pred-card-1">
                    <div class="d-flex justify-content-between small text-white-50 mb-1">
                        <span class="fw-bold text-white">👀 I See You</span>
                        <span id="pred-pct-1" class="font-monospace text-info">0%</span>
                    </div>
                    <div class="hud-meter">
                        <div id="pred-bar-1" class="hud-meter-fill" style="width: 0%;"></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="hud-pred-card text-start" id="pred-card-2">
                    <div class="d-flex justify-content-between small text-white-50 mb-1">
                        <span class="fw-bold text-white">🤫 Quiet Down</span>
                        <span id="pred-pct-2" class="font-monospace text-info">0%</span>
                    </div>
                    <div class="hud-meter">
                        <div id="pred-bar-2" class="hud-meter-fill" style="width: 0%;"></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="hud-pred-card text-start" id="pred-card-3">
                    <div class="d-flex justify-content-between small text-white-50 mb-1">
                        <span class="fw-bold text-white">💃 Get Busy</span>
                        <span id="pred-pct-3" class="font-monospace text-info">0%</span>
                    </div>
                    <div class="hud-meter">
                        <div id="pred-bar-3" class="hud-meter-fill" style="width: 0%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Game Action Controls -->
    <div class="controls my-3 text-center">
        <button id="start-button" type="button" class="btn btn-success btn-lg px-4 me-2 shadow">
            ▶ Start Camera
        </button>
        <button id="stop" type="button" class="btn btn-danger btn-lg px-4 me-2 shadow" style="display: none;">
            ⏹ Stop Camera
        </button>
        <button id="restart" type="button" class="btn btn-primary btn-lg px-4 shadow" style="display: none;">
            🔄 Play Again
        </button>
    </div>

    <!-- Interactive Simulation Test Panel -->
    <div class="card bg-dark border-secondary border-opacity-25 mx-auto mt-4 p-3" style="max-width: 680px;">
        <div class="small text-white-50 mb-2 text-center">
            <strong>Interactive Gesture Test Controls</strong> (Click button to trigger gesture for testing):
        </div>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-info sim-btn" data-gesture="Hungry">🍽️ Hungry</button>
            <button type="button" class="btn btn-sm btn-outline-info sim-btn" data-gesture="I See You">👀 I See You</button>
            <button type="button" class="btn btn-sm btn-outline-info sim-btn" data-gesture="Quiet Down">🤫 Quiet Down</button>
            <button type="button" class="btn btn-sm btn-outline-info sim-btn" data-gesture="Get Busy">💃 Get Busy</button>
        </div>
    </div>
</div>

<div class="container text-center">
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@1.3.1/dist/tf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@teachablemachine/pose@0.8/dist/teachablemachine-pose.min.js"></script>
    <script src="/js/model.js"></script>
</div>

{{> footer.handlebars}}