{{> header}}
<div class="text-center mx-auto my-4" style="max-width: 600px;">
    <h1 class="mb-4">Leaderboard</h1>
    <div class="table-responsive rounded shadow">
        <table class="table table-dark table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Player Name</th>
                    <th scope="col">Age</th>
                    <th scope="col">Score</th>
                </tr>
            </thead>
            <tbody>
                {{#each playerList}}
                <tr>
                    <td class="font-monospace fw-bold">#{{@index}}</td>
                    <td>{{playerName}}</td>
                    <td>{{playerAge}}</td>
                    <td>
                        <span class="badge bg-success">
                            {{score}} / 4
                        </span>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <div class="mt-4">
     
     
        <a href="/" class="btn btn-outline-light">New Session</a>
    </div>
</div>
{{> footer}}